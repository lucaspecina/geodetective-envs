# Project-specific
#
# Política de qué entra a git:
#   - SÍ: JSONs canónicos (candidates, results, detections, smoke_results, etc.)
#   - NO: HTMLs (regenerables con scripts build_*.py)
#   - NO: results.json individuales >5MB (tienen base64 embed)
#   - NO: imágenes generadas (grids, viz, blurred)
#
# Orden de gitignore: las reglas posteriores ganan, así que las exceptions
# específicas (los archivos pesados que queremos excluir) van AL FINAL.

experiments/*/

# === Exceptions canónicas por experimento (UNIGNORE) ===

# E004 atacante GPT-4o
!experiments/E004_attacker_filter/
experiments/E004_attacker_filter/*
!experiments/E004_attacker_filter/results.json

# E005 ReAct pilot v3 (annotated)
!experiments/E005_react_pilot/
experiments/E005_react_pilot/*
!experiments/E005_react_pilot/annotated_v3_thinking_visible.json

# E007 corpus sample (v1 + v2 + final post-selección manual + blacklist)
!experiments/E007_sample_diverso/
experiments/E007_sample_diverso/*
!experiments/E007_sample_diverso/candidates.json
!experiments/E007_sample_diverso/audit_summary.json
!experiments/E007_sample_diverso/candidates_v2.json
!experiments/E007_sample_diverso/audit_v2_summary.json
!experiments/E007_sample_diverso/candidates_v2_final.json
!experiments/E007_sample_diverso/candidates_need_reblur.json
!experiments/E007_sample_diverso/candidates_rejected_v2.json
!experiments/E007_sample_diverso/blacklist_cids.json

# E008 smoke cross-model
!experiments/E008_multimodel/
experiments/E008_multimodel/*
!experiments/E008_multimodel/results_*.json
!experiments/E008_multimodel/smoke_test_results.json

# E009 cross-model post-adapter
!experiments/E009_multimodel/
experiments/E009_multimodel/*
!experiments/E009_multimodel/results_*.json
!experiments/E009_multimodel/agentic_probe.json

# E010 iteration pilot
!experiments/E010_iteration_pilot/
experiments/E010_iteration_pilot/*
!experiments/E010_iteration_pilot/results_*.json
!experiments/E010_iteration_pilot/picked_photos.json

# E011 text overlay detection
!experiments/E011_text_overlay_detection/
experiments/E011_text_overlay_detection/*
!experiments/E011_text_overlay_detection/sample*/
experiments/E011_text_overlay_detection/sample*/*
!experiments/E011_text_overlay_detection/sample*/detections.json

# E012 min_steps ablation
!experiments/E012_min_steps/
experiments/E012_min_steps/*
!experiments/E012_min_steps/results_*.json
!experiments/E012_min_steps/picked_photos.json

# E013 grid reading smoke
!experiments/E013_grid_smoke/
experiments/E013_grid_smoke/*
!experiments/E013_grid_smoke/smoke_results.json
!experiments/E013_grid_smoke/grid_*x*_metadata.json

# E014 diverse10 (10 fotos random del corpus con prompts iterativos)
!experiments/E014_diverse10/
experiments/E014_diverse10/*
!experiments/E014_diverse10/results_*.json

# Métricas agregadas
!experiments/metrics_summary.json

# === RE-IGNORE de archivos pesados (último match gana) ===

# HTMLs siempre fuera (regenerables, >10MB cada uno)
experiments/**/*.html

# Results JSONs pesados específicos (>5MB, contienen base64 embedded — regenerables)
experiments/E005_react_pilot/results_v3_thinking_visible.json
